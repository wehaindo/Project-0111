<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!-- Sync Status Indicator Styles -->
    <t t-name="SyncStatusStyles">
        <style>
            .pos-sync-status {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 5px 10px;
                cursor: pointer;
                background: rgba(255, 255, 255, 0.1);
                border-radius: 4px;
                margin-left: 10px;
            }

            .pos-sync-status:hover {
                background: rgba(255, 255, 255, 0.2);
            }

            .sync-indicator {
                width: 12px;
                height: 12px;
                border-radius: 50%;
                display: inline-block;
                position: relative;
            }

            .sync-indicator.online {
                background-color: #4caf50;
                box-shadow: 0 0 5px #4caf50;
            }

            .sync-indicator.offline {
                background-color: #f44336;
                box-shadow: 0 0 5px #f44336;
            }

            .sync-indicator.syncing {
                animation: pulse 1s infinite;
            }

            @keyframes pulse {
                0%, 100% {
                    opacity: 1;
                    transform: scale(1);
                }
                50% {
                    opacity: 0.5;
                    transform: scale(1.2);
                }
            }

            .pending-count {
                background-color: #ff9800;
                color: white;
                padding: 2px 6px;
                border-radius: 10px;
                font-size: 11px;
                font-weight: bold;
                min-width: 18px;
                text-align: center;
            }

            .delta-sync-badge {
                background-color: #2196f3;
                color: white;
                padding: 2px 8px;
                border-radius: 10px;
                font-size: 10px;
                font-weight: bold;
                margin-left: 5px;
                animation: pulse-blue 1.5s infinite;
            }

            @keyframes pulse-blue {
                0%, 100% {
                    opacity: 1;
                }
                50% {
                    opacity: 0.6;
                }
            }

            .sync-details {
                text-align: left;
                min-width: 300px;
            }

            .sync-details h3 {
                margin-top: 0;
                border-bottom: 2px solid #ccc;
                padding-bottom: 10px;
            }

            .sync-details h4 {
                margin-top: 15px;
                margin-bottom: 5px;
                color: #666;
            }

            .sync-details p {
                margin: 5px 0;
            }

            .sync-actions {
                display: flex;
                gap: 10px;
                margin-top: 20px;
            }

            .sync-actions .button {
                flex: 1;
                padding: 8px 12px;
                background: #009688;
                color: white;
                border: none;
                border-radius: 4px;
                cursor: pointer;
                font-size: 14px;
            }

            .sync-actions .button:hover {
                background: #00796b;
            }

            .sync-actions .btn-retry-failed {
                background: #ff9800;
            }

            .sync-actions .btn-retry-failed:hover {
                background: #f57c00;
            }

            .sync-actions .btn-clear-synced {
                background: #9e9e9e;
            }

            .sync-actions .btn-clear-synced:hover {
                background: #757575;
            }

            /* ── js_manual_sync icon cursor ──────────────────── */
            .js_manual_sync .oe_icon { cursor: pointer; }

            /* ── Popup overlay ───────────────────────────────── */
            .sync-popup-overlay {
                position: fixed;
                top: 0; left: 0; right: 0; bottom: 0;
                background: rgba(0,0,0,0.45);
                z-index: 9990;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .sync-popup {
                background: #fff;
                border-radius: 10px;
                width: 320px;
                box-shadow: 0 8px 32px rgba(0,0,0,0.25);
                overflow: hidden;
                animation: popup-in 0.18s ease;
            }
            @keyframes popup-in {
                from { transform: scale(0.9); opacity: 0; }
                to   { transform: scale(1);   opacity: 1; }
            }

            .sync-popup-header {
                background: #00796b;
                color: #fff;
                padding: 14px 16px;
                display: flex;
                align-items: center;
                justify-content: space-between;
                font-size: 15px;
                font-weight: 600;
            }
            .sync-popup-title i { margin-right: 8px; }
            .sync-popup-close {
                cursor: pointer;
                font-size: 18px;
                opacity: 0.8;
                line-height: 1;
            }
            .sync-popup-close:hover { opacity: 1; }

            .sync-popup-body {
                padding: 10px 12px 14px;
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .sync-popup-divider {
                height: 1px;
                background: #eee;
                margin: 4px 0;
            }

            .sync-popup-btn {
                display: flex;
                align-items: center;
                gap: 12px;
                width: 100%;
                padding: 10px 14px;
                background: #f5f5f5;
                border: 1px solid #e0e0e0;
                border-radius: 7px;
                cursor: pointer;
                text-align: left;
                transition: background 0.15s;
            }
            .sync-popup-btn:hover:not(:disabled) { background: #e8f5e9; border-color: #a5d6a7; }
            .sync-popup-btn:disabled { opacity: 0.55; cursor: not-allowed; }
            .sync-popup-btn i {
                font-size: 18px;
                width: 22px;
                text-align: center;
                color: #00796b;
            }
            .sync-popup-btn.btn-sync-all  i { color: #1565c0; }
            .sync-popup-btn.btn-delete-sync i { color: #c62828; }
            .sync-popup-btn.btn-stock-sync  i { color: #e65100; }

            .sync-popup-btn-label {
                font-weight: 600;
                font-size: 14px;
                color: #212121;
                display: block;
                line-height: 1.2;
            }
            .sync-popup-btn-desc {
                font-size: 11px;
                color: #757575;
                display: block;
            }

            .sync-popup-status {
                padding: 8px 16px 12px;
                font-size: 13px;
                color: #555;
                border-top: 1px solid #eee;
                text-align: center;
            }
            .sync-popup-status.success { color: #2e7d32; }
            .sync-popup-status.error   { color: #c62828; }

            /* ── Offline indicator banner ──────────────────────── */
            /* Offline indicator banner */
            .offline-banner {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                background: #f44336;
                color: white;
                text-align: center;
                padding: 10px;
                z-index: 9999;
                font-weight: bold;
                box-shadow: 0 2px 5px rgba(0,0,0,0.3);
            }

            .offline-banner.hidden {
                display: none;
            }

            /* Loading indicator for lazy load */
            .product-loading {
                text-align: center;
                padding: 20px;
                color: #999;
            }

            .product-loading:after {
                content: "Loading products...";
                animation: dots 1.5s infinite;
            }

            @keyframes dots {
                0%, 20% { content: "Loading products"; }
                40% { content: "Loading products."; }
                60% { content: "Loading products.."; }
                80%, 100% { content: "Loading products..."; }
            }
        </style>
    </t>

    <!-- Sync Status Widget Template -->
    <t t-name="SyncStatusWidget">
        <div class="pos-sync-status">
            <span class="sync-indicator" t-att-class="widget.status_class" t-att-title="widget.status_text"></span>
            <span class="pending-count" t-if="widget.pending_count > 0">
                <t t-esc="widget.pending_count"/>
            </span>
            <span class="delta-sync-badge" t-if="widget.delta_syncing">
                <t t-esc="widget.delta_progress"/>
            </span>
        </div>
    </t>

    <!-- Offline Banner Template -->
    <t t-name="OfflineBanner">
        <div class="offline-banner" t-att-class="widget.is_online ? 'hidden' : ''">
            ⚠️ Working Offline - Orders will sync when connection is restored
        </div>
    </t>

    <!-- Sync Details Popup -->
    <t t-name="SyncDetailsPopup">
        <div class="modal-dialog">
            <div class="modal-content">
                <header class="modal-header">
                    <h4 class="modal-title">Hybrid Sync Status</h4>
                    <span class="button close-button" t-on-click="widget.close">×</span>
                </header>
                <main class="modal-body">
                    <div class="sync-details">
                        <h3>Connection Status</h3>
                        <p>
                            <strong>Status:</strong>
                            <span t-if="widget.is_online" style="color: #4caf50;">● Online</span>
                            <span t-else="" style="color: #f44336;">● Offline</span>
                        </p>
                        
                        <h4>Sync Queue</h4>
                        <p><strong>Pending:</strong> <t t-esc="widget.queue_status.pending"/></p>
                        <p><strong>Syncing:</strong> <t t-esc="widget.queue_status.syncing"/></p>
                        <p><strong>Failed:</strong> <t t-esc="widget.queue_status.failed"/></p>
                        <p><strong>Synced:</strong> <t t-esc="widget.queue_status.synced"/></p>
                        <p><strong>Total:</strong> <t t-esc="widget.queue_status.total"/></p>
                        
                        <h4>Statistics</h4>
                        <p><strong>Total Synced:</strong> <t t-esc="widget.stats.total_synced"/></p>
                        <p><strong>Total Failed:</strong> <t t-esc="widget.stats.total_failed"/></p>
                        <p t-if="widget.stats.last_sync">
                            <strong>Last Sync:</strong> <t t-esc="widget.stats.last_sync"/>
                        </p>
                        
                        <div class="sync-actions">
                            <button class="button btn-sync-now" t-on-click="widget.sync_now">
                                Sync Now
                            </button>
                            <button class="button btn-retry-failed" t-on-click="widget.retry_failed">
                                Retry Failed
                            </button>
                            <button class="button btn-clear-synced" t-on-click="widget.clear_synced">
                                Clear Synced
                            </button>
                        </div>
                    </div>
                </main>
            </div>
        </div>
    </t>

    <!-- Product Loading Indicator -->
    <t t-name="ProductLoadingIndicator">
        <div class="product-loading">
            <!-- Loading animation -->
        </div>
    </t>

    <!-- Manual Sync Controls Widget — single navbar icon + popup -->
    <t t-name="ManualSyncControls">
        <div class="oe_status js_manual_sync">
            <div class="oe_icon js_idle" title="Sync Options">
                <i class="fa fa-fw fa-refresh" role="img" aria-label="Sync Options" title="Sync Options"></i>
            </div>
            <div class="oe_icon js_syncing oe_hidden">
                <i class="fa fa-fw fa-spin fa-spinner" role="img" aria-label="Syncing" title="Syncing…"></i>
            </div>
            <div class="oe_icon oe_green js_done oe_hidden">
                <i class="fa fa-fw fa-check" role="img" aria-label="Sync Done" title="Sync Done"></i>
            </div>
            <div class="oe_icon oe_red js_error oe_hidden">
                <i class="fa fa-fw fa-warning" role="img" aria-label="Sync Error" title="Sync Error"></i>
            </div>
        </div>
    </t>

</templates>
