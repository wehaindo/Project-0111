<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- POS Config Form View - Add Hybrid Sync Settings -->
        <record id="view_pos_config_form_hybrid_sync" model="ir.ui.view">
            <field name="name">pos.config.form.hybrid.sync</field>
            <field name="model">pos.config</field>
            <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//h2[@name='order']" position="before">
                    <h2>Hybrid Sync</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="enable_hybrid_sync"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="enable_hybrid_sync" string="Enable Hybrid Sync"/>
                                <div class="text-muted">
                                    Offline-first POS with background synchronization
                                </div>
                                <div class="content-group mt16" attrs="{'invisible': [('enable_hybrid_sync', '=', False)]}">
                                    <div class="row">
                                        <label string="Sync Interval (seconds)" for="sync_interval" class="col-lg-4 o_light_label"/>
                                        <field name="sync_interval"/>
                                    </div>
                                    <div class="row">
                                        <label string="Max Sync Retries" for="max_sync_retries" class="col-lg-4 o_light_label"/>
                                        <field name="max_sync_retries"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="enable_auto_save"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="enable_auto_save" string="Auto-Save Orders"/>
                                <div class="text-muted">
                                    Automatically save orders to prevent data loss
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="enable_delta_sync"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="enable_delta_sync" string="Delta Sync"/>
                                <div class="text-muted">
                                    Sync only modified products and partners
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" attrs="{'invisible': [('enable_hybrid_sync', '=', False)]}">
                            <div class="o_setting_left_pane">
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="sync_method" string="Sync Method"/>
                                <div class="text-muted">
                                    Choose how products are loaded
                                </div>
                                <div class="content-group mt16">
                                    <div class="row">
                                        <field name="sync_method" class="o_light_label" widget="radio"/>
                                    </div>
                                    <div class="text-muted mt8">
                                        <strong>Normal POS:</strong> Load all products at startup (standard Odoo)<br/>
                                        <strong>Lazy Load:</strong> Zero initial load, products load only when searched/scanned (best for 10k+ products)<br/>
                                        <strong>Hybrid:</strong> Load initial batch + on-demand loading
                                    </div>
                                </div>
                                <div class="content-group mt16" attrs="{'invisible': [('sync_method', '!=', 'hybrid')]}">
                                    <div class="row">
                                        <label string="Initial Product Limit" for="initial_product_limit" class="col-lg-4 o_light_label"/>
                                        <field name="initial_product_limit"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- Stock Synchronization Settings -->
                        <div class="col-12 col-lg-6 o_setting_box" attrs="{'invisible': [('enable_hybrid_sync', '=', False)]}">
                            <div class="o_setting_left_pane">
                                <field name="enable_stock_sync"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="enable_stock_sync" string="Enable Stock Sync"/>
                                <div class="text-muted">
                                    Sync real-time stock quantities from warehouse
                                </div>
                                <div class="content-group mt16" attrs="{'invisible': [('enable_stock_sync', '=', False)]}">
                                    <div class="row">
                                        <label string="Stock Location" for="stock_location_id" class="col-lg-4 o_light_label"/>
                                        <field name="stock_location_id"/>
                                    </div>
                                    <div class="row">
                                        <label string="Stock Sync Interval (minutes)" for="stock_sync_interval" class="col-lg-4 o_light_label"/>
                                        <field name="stock_sync_interval"/>
                                    </div>
                                    <div class="row">
                                        <label string="Low Stock Threshold" for="low_stock_threshold" class="col-lg-4 o_light_label"/>
                                        <field name="low_stock_threshold"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" attrs="{'invisible': [('enable_stock_sync', '=', False)]}">
                            <div class="o_setting_left_pane">
                                <field name="show_stock_quantity"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="show_stock_quantity" string="Show Stock Quantity"/>
                                <div class="text-muted">
                                    Display stock levels on product cards in POS
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box" attrs="{'invisible': [('enable_stock_sync', '=', False)]}">
                            <div class="o_setting_left_pane">
                                <field name="prevent_negative_stock"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="prevent_negative_stock" string="Prevent Negative Stock"/>
                                <div class="text-muted">
                                    Block adding products to cart if insufficient stock
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ── Real-Time Monitor Section ── -->
                    <h2>Real-Time Monitor</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_left_pane">
                                <field name="enable_ws_monitor"/>
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="enable_ws_monitor" string="Enable WebSocket Monitor"/>
                                <div class="text-muted">
                                    Connect this terminal to the real-time command center dashboard
                                </div>
                                <div class="content-group mt16" attrs="{'invisible': [('enable_ws_monitor', '=', False)]}">
                                    <div class="row">
                                        <label string="WebSocket Server URL" for="ws_server_url" class="col-lg-4 o_light_label"/>
                                        <field name="ws_server_url" placeholder="ws://localhost:8080"/>
                                    </div>
                                    <div class="row">
                                        <label string="Terminal ID" for="ws_pos_id" class="col-lg-4 o_light_label"/>
                                        <field name="ws_pos_id" placeholder="Leave blank to use POS name"/>
                                    </div>
                                    <div class="row">
                                        <label string="Heartbeat Interval (s)" for="ws_heartbeat_interval" class="col-lg-4 o_light_label"/>
                                        <field name="ws_heartbeat_interval"/>
                                    </div>
                                    <div class="text-muted mt8">
                                        <strong>Command Center:</strong>
                                        Open <a href="http://localhost:3000" target="_blank">http://localhost:3000</a>
                                        to monitor and remotely trigger sync.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- POS Session Form View - Add Sync Info -->
        <record id="view_pos_session_form_sync_info" model="ir.ui.view">
            <field name="name">pos.session.form.sync.info</field>
            <field name="model">pos.session</field>
            <field name="inherit_id" ref="point_of_sale.view_pos_session_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='config_id']" position="after">
                    <field name="last_sync_timestamp" readonly="1"/>
                    <field name="pending_sync_count" readonly="1"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
